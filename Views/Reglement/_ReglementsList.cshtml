@using InventoryManagementMVC.Models.Entities
@model List<Reglement>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Partenaire</th>
                    <th>Montant</th>
                    <th>Mode</th>
                    <th>N° Paiement</th>
                    <th>Note</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reglement in Model)
                {
                    <tr class="reglement-row" data-reglement-id="@reglement.IdReglement">
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-semibold">@reglement.DatePaiement.ToString("dd/MM/yyyy")</span>
                                <small class="text-muted">@reglement.DatePaiement.ToString("dddd")</small>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (reglement.Partenaire is Client)
                                {
                                    <span class="badge bg-success me-2" title="Client">
                                        <i class="fas fa-user-tie"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark me-2" title="Fournisseur">
                                        <i class="fas fa-truck"></i>
                                    </span>
                                }
                                <div>
                                    <div class="fw-semibold">@reglement.Partenaire.Nom</div>
                                    @if (!string.IsNullOrEmpty(reglement.Partenaire.Email))
                                    {
                                        <small class="text-muted">@reglement.Partenaire.Email</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="fw-bold text-success fs-5">
                                @reglement.Montant.ToString("C")
                            </span>
                        </td>
                        <td>
                            @switch (reglement.ModePaiement)
                            {
                                case ModePaiement.Especes:
                                    <span class="badge bg-success">
                                        <i class="fas fa-money-bill-wave me-1"></i>
                                        @Html.DisplayFor(m => reglement.ModePaiement)
                                    </span>
                                    break;
                                case ModePaiement.Cheque:
                                    <span class="badge bg-primary">
                                        <i class="fas fa-money-check me-1"></i>
                                        @Html.DisplayFor(m => reglement.ModePaiement)
                                    </span>
                                    break;
                                case ModePaiement.Effet:
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-file-invoice me-1"></i>
                                        @Html.DisplayFor(m => reglement.ModePaiement)
                                    </span>
                                    break;
                                case ModePaiement.VirementBancaire:
                                    <span class="badge bg-info">
                                        <i class="fas fa-university me-1"></i>
                                        @Html.DisplayFor(m => reglement.ModePaiement)
                                    </span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(reglement.NumeroPaiement))
                            {
                                <code class="bg-light text-dark p-1 rounded">@reglement.NumeroPaiement</code>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(reglement.Note))
                            {
                                var noteShort = reglement.Note.Length > 25 ? reglement.Note.Substring(0, 25) + "..." : reglement.Note;
                                <span class="text-truncate d-inline-block" style="max-width: 120px;" title="@reglement.Note">
                                    <i class="fas fa-sticky-note text-warning me-1"></i>@noteShort
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Reglement" asp-action="Details" asp-route-id="@reglement.IdReglement"
                                   class="btn btn-sm btn-outline-primary" title="Voir les détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-controller="Reglement" asp-action="Edit" asp-route-id="@reglement.IdReglement"
                                   class="btn btn-sm btn-outline-secondary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="Supprimer"
                                        onclick="confirmDeletePartial(@reglement.IdReglement, '@reglement.Partenaire.Nom', '@reglement.DatePaiement.ToString("dd/MM/yyyy")')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="2" class="fw-bold">
                        <i class="fas fa-calculator me-2"></i>Total (@Model.Count règlements)
                    </td>
                    <td class="fw-bold text-success fs-5">
                        @Model.Sum(r => r.Montant).ToString("C")
                    </td>

                    <!-- 
                    <td colspan="4" class="text-muted">
                        Moyenne: @(Model.Count > 0 ? Model.Average(r => r.Montant).ToString("C") : "0,00 €")
                    </td> -->
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Statistiques par mode de paiement -->
    <div class="mt-3">
        <div class="row">
            @{
                var statsByMode = Model.GroupBy(r => r.ModePaiement)
                .ToDictionary(g => g.Key, g => new { Count = g.Count(), Total = g.Sum(r => r.Montant) });
            }

            @foreach (var stat in statsByMode)
            {
                <div class="col-md-3 mb-2">
                    <div class="card border-0 bg-light">
                        <div class="card-body p-2 text-center">
                            <div class="small">
                                @switch (stat.Key)
                                {
                                    case ModePaiement.Especes:
                                        <i class="fas fa-money-bill-wave text-success me-1"></i>
                                        break;
                                    case ModePaiement.Cheque:
                                        <i class="fas fa-money-check text-primary me-1"></i>
                                        break;
                                    case ModePaiement.Effet:
                                        <i class="fas fa-file-invoice text-warning me-1"></i>
                                        break;
                                    case ModePaiement.VirementBancaire:
                                        <i class="fas fa-university text-info me-1"></i>
                                        break;
                                }
                                @Html.DisplayFor(m => stat.Key)
                            </div>
                            <div class="fw-bold text-success">@stat.Value.Total.ToString("C")</div>
                            <div class="text-muted small">@stat.Value.Count règlement(s)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-credit-card fa-4x text-muted mb-3"></i>
        <h5 class="text-muted">Aucun règlement trouvé</h5>
        <p class="text-muted">Aucun règlement ne correspond aux critères sélectionnés</p>
        <a asp-controller="Reglement" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Créer un nouveau règlement
        </a>
    </div>
}

<style>
    .reglement-row:hover {
        background-color: #f8f9fa !important;
        cursor: pointer;
    }

    .btn-group .btn {
        border: none;
        margin: 0 1px;
    }

        .btn-group .btn:hover {
            transform: scale(1.05);
            transition: transform 0.2s ease;
        }

    .badge {
        font-size: 0.75em;
    }

    .table th {
        border-bottom: 2px solid #dee2e6;
        font-weight: 600;
        color: #495057;
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

    .table tfoot td {
        border-top: 2px solid #dee2e6;
        font-weight: 500;
    }

    code {
        font-size: 0.8em;
    }
</style>

<script>
    function confirmDeletePartial(reglementId, partenaireNom, datePaiement) {
        if (confirm(`Êtes-vous sûr de vouloir supprimer le règlement de ${partenaireNom} du ${datePaiement} ?`)) {
            // Vous pouvez utiliser AJAX ici pour supprimer sans recharger la page
            // Ou rediriger vers l'action de suppression
            window.location.href = `/Reglement/Delete/${reglementId}`;
        }
    }

    // Rendre les lignes cliquables pour voir les détails
    document.querySelectorAll('.reglement-row').forEach(row => {
        row.addEventListener('click', function(e) {
            // Ne pas déclencher si on clique sur un bouton
            if (!e.target.closest('.btn-group')) {
                const reglementId = this.dataset.reglementId;
                window.location.href = `/Reglement/Details/${reglementId}`;
            }
        });
    });
</script>