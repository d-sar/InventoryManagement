@using InventoryManagementMVC.Models
@using InventoryManagementMVC.Models.Entities
@using InventoryManagementMVC.Models.ViewModels.gestiondesReglements

@model ReglementIndexViewModel

@{
    ViewData["Title"] = Model.TitrePage;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-credit-card me-2 text-primary"></i>
        @Model.TitrePage
    </h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nouveau Règlement
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
